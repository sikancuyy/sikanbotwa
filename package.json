    "btch-downloader": "^6.4.0",
    "cakkatrok-instagram-downloader": "^2.0.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "instagram-url-direct": "^2.0.7",
    "pdfkit": "^0.20.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "wa-sticker-formatter": "^4.4.4"
  }
